# ============================================================
#  إعدادات بيئة التشغيل - انسخه إلى .env ثم عدّل القيم
# ============================================================

# وضع البيانات:
#   demo  = للاختبارات المعزولة فقط؛ محظور في النشر
#   live  = بيانات السوق الحقيقية (يحتاج انترنت + yfinance)
#   auto  = مكافئ لـ live، لا رجوع إلى الديمو
RSS_DATA_MODE=live

# منفذ لوحة الداشبورد
RSS_PORT=8000
RSS_HOST=0.0.0.0

# هوية الاتصال بخدمات SEC (مطلوبة من SEC EDGAR - ضع بريدك)
SEC_USER_AGENT=rs-reversal-terminal/1.0 (your-email@example.com)

# معاملات الاستراتيجية (اتركها فارغة لاستخدام القيم الافتراضية في config/strategy.yml)
RSS_RS_WINDOW_DAYS=60          # أقصى عمر للتقسيم العكسي بالأيام (شهرين)
RSS_MIN_DROP_PCT=30            # أدنى نسبة هبوط من قمة ما بعد التقسيم
RSS_MIN_BASE_SESSIONS=3        # أدنى عدد جلسات ثبات على القاع
RSS_MAX_BASE_SESSIONS=12       # أقصى عدد جلسات قبل اعتبار القاعدة ميتة
RSS_RSI_OVERSOLD=30            # عتبة التشبع البيعي
RSS_MIN_RVOL=1.5               # أدنى حجم نسبي لاعتماد الاختراق
